# Copiar a .env: cp .env.example .env
APP_NAME=ProcesoImagen
APP_ENV=development
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://procesoimagen:procesoimagen@localhost:5438/procesoimagen
# Desde backend local usar rutas relativas al cwd backend/
STORAGE_PATH=../storage
DATASET_PATH=../dataset
MAX_UPLOAD_MB=15
# Incluir localhost (dev) y la IP/dominio público del servidor (prod).
CORS_ORIGINS=http://localhost:5273,http://127.0.0.1:5273,http://localhost:8300,http://161.132.53.51:5273,http://161.132.53.51:8300
# URL que el navegador usa para llamar a la API (en servidor: IP o dominio público).
VITE_API_URL=http://161.132.53.51:8300
